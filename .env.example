# ===========================================
# POSGRO - Environment Configuration
# ===========================================

# App Mode (pos | server)
APP_MODE=pos

# ===========================================
# Database Configuration
# ===========================================
# For POS Terminal (SQLite):
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./pos-local.db

# For VPS Server (PostgreSQL):
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/posgro
#
# Docker Compose vars — MUST match each other. The docker-compose environment:
# block constructs DATABASE_URL from these, overriding any value set above.
# DB_USER=grocery_user
# DB_PASSWORD=your-secure-db-password

# ===========================================
# POS Terminal Configuration
# ===========================================
# VPS Connection
VPS_API_URL=https://pos.bobur-dev.uz

# Terminal Identity
TERMINAL_ID=T1

# Sync Settings
SYNC_INTERVAL_MS=300000
RETRY_INTERVAL_MS=60000

# Printer (optional)
PRINTER_NAME=TM-T20II
PRINTER_TYPE=thermal

# ===========================================
# VPS Server Configuration
# ===========================================
# JWT Authentication
JWT_SECRET=your-very-secure-secret-key-minimum-32-chars
JWT_EXPIRES_IN=8h

# Signs store licenses (src/shared/utils/license.ts): base64 of an Ed25519 PKCS8 private key, made
# once by `node scripts/generate-license-keys.mjs`. The same key for staging and production. Without
# it the server issues no licenses and POS terminals cannot renew theirs.
LICENSE_SIGNING_KEY=

# Telegram Bot (optional)
#
# Unset, the bot never starts and the server just logs "Telegram bot disabled". Set, the server
# long-polls Telegram, serves the store/supplier menus, and forwards terminal log alerts to the
# admins who have linked their phone.
#
# IMPORTANT: exactly one process may poll a given token. Both deploy workflows write .env from the
# same secrets.ENV_FILE, so staging overrides this to empty in docker-compose.staging.yml and picks
# up TELEGRAM_BOT_TOKEN_STAGING instead — give staging its own @BotFather bot if you want to test
# there. Two processes on one token get 409 Conflict and neither works reliably.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# A second bot, used only by the staging stack. Optional; staging's bot stays off without it.
TELEGRAM_BOT_TOKEN_STAGING=

# Where the bot's "Web panel" button sends people.
WEB_APP_URL=https://pos.bobur-dev.uz

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================================
# AI / OCR
# ===========================================
# Anthropic API key (used by NestJS server for paid-tier stores)
ANTHROPIC_API_KEY=sk-ant-...

# ASL BELGISI API key (generate in https://xtrace.aslbelgisi.uz personal account)
ASLBELGISI_API_KEY=

# PaddleOCR Python microservice URL (used internally by NestJS)
PYTHON_OCR_URL=http://ocr-python:8001

# ===========================================
# File Storage
# ===========================================
# Absolute path for uploaded files (banner images, etc.)
# Defaults to <cwd>/uploads/ — set this to a path outside dist/ to survive rebuilds
# UPLOADS_DIR=/var/data/grocery-pos/uploads

# ===========================================
# Debug
# ===========================================
DEBUG=false
LOG_LEVEL=info
